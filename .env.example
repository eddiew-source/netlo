# Site remains noindex until you explicitly enable launch mode.
NEXT_PUBLIC_SITE_URL=https://netlo.uk
NEXT_PUBLIC_SITE_LIVE=false

# Leave unset until you've verified and provisioned a mail sender.
# Configure Resend API key, a verified sender domain/address, and a destination mailbox.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# ICUK integration intentionally not active. Do not expose API keys via NEXT_PUBLIC_ variables.
# ICUK_API_BASE_URL=
# ICUK_API_KEY=
